root = Stack([h, kpis, pie, bars, tbl, note], "column", 12)
h = Heading("年度市场预算分配：合计 1,200 万元", 2)
kpis = Grid([k1, k2, k3], 3, 12, 150)
k1 = StatCard("预算总额", "1,200 万元", "较去年 +8%", "up", "💼", null, "brand")
k2 = StatCard("已执行", "846 万元", "执行率 70.5%", "flat", "📊", "截至第三季度末", "success")
k3 = StatCard("剩余额度", "354 万元", "四季度的投放空间", "down", null, null, "warning")
pie = PieChart("预算构成", [{label: "品牌广告", value: 420}, {label: "效果投放", value: 360}, {label: "内容与活动", value: 240}, {label: "渠道合作", value: 120}, {label: "预留机动", value: 60}], true)
bars = Stack([ProgressBar("品牌广告执行率", 78, 100, "brand"), ProgressBar("效果投放执行率", 82, 100, "success"), ProgressBar("内容与活动执行率", 55, 100, "warning"), ProgressBar("渠道合作执行率", 40, 100, "danger")], "column", 8)
tbl = Table("分项预算与执行", ["科目", "预算（万元）", "已执行（万元）", "执行率"], [{"科目": "品牌广告", "预算（万元）": 420, "已执行（万元）": 328, "执行率": "78%"}, {"科目": "效果投放", "预算（万元）": 360, "已执行（万元）": 295, "执行率": "82%"}, {"科目": "内容与活动", "预算（万元）": 240, "已执行（万元）": 132, "执行率": "55%"}, {"科目": "渠道合作", "预算（万元）": 120, "已执行（万元）": 48, "执行率": "40%"}, {"科目": "预留机动", "预算（万元）": 60, "已执行（万元）": 43, "执行率": "72%"}])
note = Callout("建议", "把品牌广告未执行的 92 万元按 6:4 追加到效果投放与内容活动，并在季度末重新评估渠道合作。", "info")
