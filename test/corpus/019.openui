root = Stack([h, t, demos, code, note], "column", 12)
h = Heading("图表类型怎么选：先问数据在表达什么", 2)
t = Table("常见图表与适用场景", ["图表类型", "适合的数据关系", "避免的场景"], [{"图表类型": "柱状图", "适合的数据关系": "类别之间的规模对比", "避免的场景": "类别过多且名称很长"}, {"图表类型": "折线图", "适合的数据关系": "时间序列的趋势与拐点", "避免的场景": "时间点稀疏且无连续含义"}, {"图表类型": "面积图", "适合的数据关系": "总量趋势及构成累积", "避免的场景": "多系列叠加导致遮挡"}, {"图表类型": "饼图", "适合的数据关系": "整体中的占比，类别不超过 5 个", "避免的场景": "类别过多或占比接近"}])
demos = Row([Chart("各渠道收入", "column", [{name: "收入", values: [1248, 986, 402]}], None, ["小程序", "App", "Web"], 180, "compact", True), Chart("月度趋势", "smooth", [{name: "收入", values: [198, 212, 224, 236]}], undefined, ["1月", "2月", "3月", "4月"], 180, "compact", False)], 12)
code = CodeBlock("chart = Chart(\"月度趋势\", \"smooth\", [{name: \"收入\", values: rows}])\npie = PieChart(\"渠道占比\", data, true)", "python", "同样的数据，两种表达")
note = Callout("判断标准", "如果读者需要比较具体数值，优先表格或柱状图；如果读者只需要看趋势方向，折线图更省认知成本。", "info")
