root = Stack([h, intro, colorCard, gap, div, typeCard, media, note], "column", 12)
h = Heading("品牌视觉规范速览", 2)
intro = TextContent("规范的目的不是限制表达，而是让不同人产出的界面看起来像同一个人做的。", "md")
colorCard = Card([CardHeader("主色与辅助色", "用于强调与状态区分"), Row([sw1, sw2, sw3], 12)])
sw1 = Box([Text("品牌色", "sm", "medium", "primary")], display="block", width="88px", height="56px", padding="8px", background="var(--dsw-alias-brand-primary)", radius="10px")
sw2 = Box([Text("成功色", "sm", "medium", "primary")], display="block", width="88px", height="56px", padding="8px", background="var(--dsw-alias-success)", radius="10px")
sw3 = Box([Text("警示色", "sm", "medium", "primary")], display="block", width="88px", height="56px", padding="8px", background="var(--dsw-alias-warning)", radius="10px")
gap = Spacer(10)
div = Divider("字体与媒体")
typeCard = Card([CardHeader("字体层级"), Text("标题 24px / 正文 14px / 注释 12px", "md"), Text("标题与正文之间保持 8 的倍数间距", "sm", "normal", "secondary")])
media = Row([Image("assets/logo-guideline.png", "标识使用示例", "120px", "72px", "8px", "contain"), Stack([Link("下载完整规范", "#brand-assets"), Text("PNG / SVG 两种格式", "sm", "normal", "tertiary")], "column", 6)], 12, "center")
note = Callout("落地建议", "把颜色与字号写成设计 token，代码里只引用 token 名，主题切换才能自动生效。", "info")
