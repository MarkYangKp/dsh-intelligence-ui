root = Stack([h, kpis, pb, cmp, tl, st, ck, empty, note], "column", 12)
h = Heading("数据组件速查", 2)
kpis = Grid([s1, s2, s3], 3, 12, 140)
s1 = StatCard("指标卡", "1,284", "+12.6%", "up", "📈", null, "success")
s2 = StatCard("目标完成度", "68%", "+14pp", "up", "🎯", "季度口径", "brand")
s3 = StatCard("风险项", "1", "依赖外部团队", "down", "⚠️", null, "warning")
pb = ProgressBar("整体进度", 72, 100, "brand")
cmp = ComparisonBar("各方案成本（万元）", [{label: "方案 A", value: 486, variant: "warning"}, {label: "方案 B", value: 312, variant: "success"}], true, " 万元")
tl = Timeline([{title: "需求评审", time: "周一", variant: "brand"}, {title: "开发联调", time: "周二至周四", variant: "info"}, {title: "灰度发布", time: "周五", variant: "success"}])
st = Steps(["评审", "开发", "灰度", "全量"], 1)
ck = Checklist("上线检查", [{text: "测试通过", status: "done"}, {text: "回滚预案", status: "doing"}])
empty = Table("空表格示例", ["列 A", "列 B"], [])
note = Callout("组合建议", "先想清楚要回答的问题，再选择组件；不要为了丰富而堆叠指标卡。", "info")
