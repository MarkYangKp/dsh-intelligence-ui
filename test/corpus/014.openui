root = Stack([h, tags, chart, tbl, rows, note], "column", 12)
h = Heading("风控模型离线评估：F1 90.2%，高危样本召回不足", 2)
tags = BadgeGroup(["样本 12.4 万", "训练 9.9 万", "验证 2.5 万"], "info")
chart = Chart("不同阈值下的精确率与召回率", "smooth", [{name: "精确率", values: [98.6, 97.2, 95.4, 92.1, 87.6]}, {name: "召回率", values: [61.2, 72.8, 81.4, 88.1, 93.5]}], ["0.9", "0.8", "0.7", "0.6", "0.5"], 240, "number", true)
tbl = Table("分风险等级的评估指标", ["风险等级", "样本数", "精确率", "召回率", "F1"], rows, false, true, true, [{key: "精确率", align: "right", format: "percent"}, {key: "召回率", align: "right", format: "percent"}, {key: "F1", align: "right", format: "number"}])
rows = [{"风险等级": "高危", "样本数": 820, "精确率": 93.4, "召回率": 66.2, "F1": 77.5}, {"风险等级": "中危", "样本数": 3120, "精确率": 89.1, "召回率": 84.7, "F1": 86.8}, {"风险等级": "低危", "样本数": 21060, "精确率": 96.2, "召回率": 94.8, "F1": 95.5}]
note = Callout("风险提示", "高危样本召回率偏低，上线前需补充高危样本或降低该等级阈值；否则会漏放关键风险。", "danger")
