root = Stack([h, q, tbl, kv, list, note], "column", 12)
h = Heading("宠物智能硬件市场速览", 2)
q = Quote("用户买的不是设备，而是「不在家时也能安心」。", "用户访谈摘要")
tbl = Table(title: "细分品类与增速", columns: ["品类", "规模（亿元）", "同比增速", "集中度"], data: rows, compact: true, striped: true)
rows = [{"品类": "智能喂食器", "规模（亿元）": 42, "同比增速": "+28%", "集中度": "中"}, {"品类": "智能猫砂盆", "规模（亿元）": 36, "同比增速": "+35%", "集中度": "低"}, {"品类": "宠物摄像头", "规模（亿元）": 28, "同比增速": "+18%", "集中度": "高"}, {"品类": "智能项圈", "规模（亿元）": 12, "同比增速": "+9%", "集中度": "中"}]
kv = KeyValue([{label: "主要渠道", value: "线上占 72%，线下体验店回升至 28%"}, {label: "价格带", value: "主力成交集中在 300–800 元"}, {label: "决策因素", value: "安全性、静音、清洁难度"}], 2)
list = BulletList(["同质化严重，差异化机会在「多宠家庭」场景", "售后与耗材复购是长期利润来源", "宠物健康数据可能成为下一轮竞争焦点"], false)
note = Callout("结论", "增速高但集中度低的品类更适合新品牌切入，建议优先验证智能猫砂盆的多宠型号。", "success")
