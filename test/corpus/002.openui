root = Stack([hd, tags, kpis, div, bars, svc, note], "column", 12)
hd = Row([Icon("🩺", 18, "success"), Heading("核心交易链路健康看板", 2)], 10, "center")
tags = BadgeGroup(["网关", "订单", "支付", "库存", "通知"], "brand")
kpis = Grid([k1, k2, k3, k4], 4, 12, 140)
k1 = StatCard("可用性", "99.97%", "近 30 天", "flat", "📈", "目标 99.95%", "success")
k2 = StatCard("P95 延迟", "186 ms", "-12 ms", "down", null, "较上周改善", "success")
k3 = StatCard("错误率", "0.18%", "+0.04pp", "up", null, null, "warning")
k4 = StatCard("告警数", "3", "全部已认领", "flat", "🚨", null, "brand")
div = Divider("链路各环节成功率")
bars = Stack([ProgressBar("订单创建成功率", 99.4, 100, "success"), ProgressBar("支付成功率", 96.8, 100, "warning"), ProgressBar("通知送达率", 88.2, 100, "danger")], "column", 8)
svc = Table("服务状态明细", ["服务", "状态", "P95 延迟", "错误率"], [{"服务": "api-gateway", "状态": "正常", "P95 延迟": "42 ms", "错误率": "0.05%"}, {"服务": "order-service", "状态": "正常", "P95 延迟": "88 ms", "错误率": "0.12%"}, {"服务": "payment-service", "状态": "观察", "P95 延迟": "156 ms", "错误率": "0.31%"}, {"服务": "notify-service", "状态": "降级", "P95 延迟": "420 ms", "错误率": "1.82%"}], true)
note = Callout("处置建议", "通知服务错误率偏高，建议先检查下游短信通道配额，再决定是否降级为仅站内信。", "warning")
