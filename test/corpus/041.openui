root = Stack([h, card1, card2, div, sp, note], "column", 12)
h = Heading("问答卡片：用原语搭出没有现成组件的信息块", 2)
card1 = Card([Row([Icon("🧩", 16, "brand"), Text("为什么需要原语", "md", "semibold")], 8, "center"), TextContent("预制组件覆盖高频形态，但总有表达不了的结构；原语让你现场拼。", "sm")])
card2 = Card([Row([ic, tx, tag], 12, "center")])
ic = Icon("✅", 14, "success")
tx = Stack([Text("保持排版一致", "sm", "medium"), Text("用 token 与间距标度控制视觉", "sm", "normal", "secondary")], "column", 4)
tag = Box([Text("已沉淀", "sm", "medium", "brand")], display="inline-flex", padding="4px 8px", background="var(--dsw-alias-bg-l3)", radius="999px")
div = Divider()
sp = Spacer(6)
note = Callout("原则", "优先复用现成组件；当语义无法被现成组件准确表达时，才用原语组合。", "info")
