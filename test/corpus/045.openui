root = Stack([h, grid1, grid2, heatCard, note], "column", 12)
h = Heading("图表组件速查", 2)
grid1 = Grid([c1, c2], 2, 12, 240)
c1 = Chart(title: "近 6 周收入", type: "area", series: [{name: "收入（万元）", values: [62, 66, 64, 71, 69, 75]}], labels: ["W1", "W2", "W3", "W4", "W5", "W6"], height: 200, yFormat: "compact")
c2 = PieChart("渠道收入占比", [{label: "小程序", value: 44}, {label: "App", value: 35}, {label: "Web", value: 15}, {label: "其它", value: 6}], true)
grid2 = Grid([sp, hm], 2, 12, 200)
sp = Stack([Sparkline([62, 66, 64, 71, 69, 75, 78, 84], 160, 40), Text("近 8 周收入走势", "sm", "normal", "tertiary")], "column", 6)
hm = Heatmap("渠道活跃度热力", [{label: "小程序", value: 8}, {label: "App", value: 6}, {label: "Web", value: 3}, {label: "其它", value: 1}], 4, 16)
heatCard = Card([CardHeader("图表选择提示"), TextContent("比较数值用柱状图，看趋势用折线图，看占比用饼图；同一份数据不要同时用三种图表表达。", "sm", true)])
note = Callout("克制", "图表越少越好：一屏最多两张图，其余信息交给表格与文字。", "info")
