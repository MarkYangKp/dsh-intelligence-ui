root = Stack([h, intro, t, c, st, note], "column", 12)
h = Heading("空态设计：先把「为什么空」说清楚", 2)
intro = TextContent("空态不是占位图，而是对用户的一次解释与引导。", "md")
t = Table("本周新增订单", ["订单号", "金额", "状态"], [])
c = Chart("近 7 天趋势", "line", [{name: "订单量", values: []}], [], [])
st = SearchTable("历史搜索", ["关键词", "搜索时间"], [], "输入关键词", "没有匹配的历史记录")
note = Callout("空态原则", "空态要说明「为什么空」和「下一步做什么」，并区分「暂无数据」与「加载失败」两种情况。", "info")
