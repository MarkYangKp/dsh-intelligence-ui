root = Stack([h, kpis, trend, charts, heat, note], "column", 12)
h = Heading("检索系统质量周报：召回率提升，延迟略升", 2)
kpis = Grid([k1, k2, k3], 3, 12, 150)
k1 = StatCard(label: "召回率 @10", value: "86.3%", delta: "+2.1pp", trend: "up", icon: "🔍", note: "近 14 天", accent: "success")
k2 = StatCard(label: "准确率 @10", value: "92.8%", delta: "+0.6pp", trend: "up", icon: null, note: null, accent: "success")
k3 = StatCard(label: "P95 延迟", value: "142 ms", delta: "+11 ms", trend: "down", icon: "⏱️", note: "索引扩容后预期回落", accent: "warning")
trend = Stack([Sparkline([78, 80, 79, 82, 81, 84, 83, 85, 84, 86, 85, 87, 86, 86], 140, 30), Text("近 14 天召回率走势", "sm", "normal", "tertiary")], "row", 10)
charts = Row([c1, c2], 12)
c1 = Chart(title: "召回率与准确率", type: "line", series: [{name: "召回率", values: [78, 80, 82, 81, 84, 86]}, {name: "准确率", values: [90, 91, 92, 91, 93, 93]}], labels: ["W1", "W2", "W3", "W4", "W5", "W6"], height: 200, yFormat: "percent")
c2 = Chart(title: "响应延迟分位", type: "bar", series: [{name: "延迟（ms）", values: [42, 68, 96, 142]}], labels: ["P50", "P90", "P99", "P95"], height: 200)
heat = Heatmap("每小时查询量热力（近一周）", [{label: "00", value: 2}, {label: "03", value: 1}, {label: "06", value: 3}, {label: "09", value: 7}, {label: "12", value: 6}, {label: "15", value: 8}, {label: "18", value: 5}, {label: "21", value: 4}], 4, 16)
note = Callout("下一步", "召回率提升来自同义词扩展；延迟上升与索引扩容有关，观察三天后再决定是否优化查询计划。", "info")
