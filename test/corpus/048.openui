root = Stack([h, intro, card, tbl, chart, note], "column", 12)
h = Heading("长文本压力测试：超长标题与连续中文段落", 2)
intro = TextContent("这是一段刻意写得较长的中文说明，用来验证正文在窄容器中的换行、行高与可读性。当内容超过三行时，行高应保持一致，段落之间不依赖空行区分；即使连续出现标点、数字与英文混排，也不应出现截断或溢出。", "md")
card = Card([CardHeader("一份需要同时兼顾可读性与信息密度的季度业务报告", "副标题同样写得比较长，用来观察换行后与标题之间的间距是否稳定"), TextContent("报告的结论应放在最前面，其次才是支撑结论的数据与推导过程；如果读者需要滚动三屏才能看到结论，说明信息结构失败了。", "sm")])
tbl = Table("长文本单元格", ["项目", "说明"], [{"项目": "数据来源", "说明": "这是一个用于验证超长中文文本在表格单元格中的换行与可读性的示例句子，长度超过四十个字符。"}, {"项目": "统计口径", "说明": "自然月去重用户，剔除测试账号与内部员工账号后计算。"}])
chart = Chart("各业务线在过去三十天内的峰值请求量对比（单位：次每秒）", "bar", [{name: "峰值 QPS", values: [1200, 980, 860, 640, 420]}], [], ["商品详情页", "购物车与结算", "订单查询服务", "优惠券领取接口", "个性化推荐流"], 240)
note = Callout("长标题处理", "标题超过两行时，优先压缩措辞而不是缩小字号；字号阶梯一旦被打破，整个界面都会失去层次。", "info")
