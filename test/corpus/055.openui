root = Stack([h, tags, kpis, row1, div, grid2, tl, note], "column", 12)
h = Heading("综合经营看板", 2)
tags = BadgeGroup(["收入", "用户", "渠道", "风险"], "info")
kpis = Grid([k1, k2, k3, k4], 4, 12, 130)
k1 = StatCard("本周收入", "84.3 万元", "+12.6%", "up", "💰", null, "brand")
k2 = StatCard("活跃用户", "12.4 万", "+3.1%", "up", "👥", null, "success")
k3 = StatCard("转化率", "3.8%", "+0.2pp", "up", "🎯", null, "success")
k4 = StatCard("退款率", "1.2%", "-0.3pp", "down", "↩️", null, "warning")
row1 = Row([trendCard, pieCard], 12)
trendCard = Card([CardHeader("收入趋势", "近 8 周"), Chart("周收入（万元）", "area", [{name: "收入", values: [62, 66, 64, 71, 69, 75, 78, 84]}], [], ["W1", "W2", "W3", "W4", "W5", "W6", "W7", "W8"], 200)])
pieCard = Card([CardHeader("渠道结构", "本周占比"), PieChart("渠道收入占比", [{label: "小程序", value: 44.1}, {label: "App", value: 35.0}, {label: "Web", value: 14.9}, {label: "其它", value: 6.0}], true)])
div = Divider("明细与风险")
grid2 = Grid([t1, stack2], 2, 12, 220)
t1 = Table("渠道明细", ["渠道", "收入（万元）", "占比", "环比"], [{"渠道": "小程序", "收入（万元）": 37.2, "占比": "44.1%", "环比": "+18.2%"}, {"渠道": "App", "收入（万元）": 29.5, "占比": "35.0%", "环比": "+6.4%"}, {"渠道": "Web", "收入（万元）": 12.6, "占比": "14.9%", "环比": "-2.1%"}], false, true, true, [{key: "收入（万元）", align: "right", format: "number"}, {key: "占比", align: "right", format: "percent"}])
stack2 = Stack([ProgressBar("季度目标完成度", 68, 100, "brand"), Heatmap("渠道活跃度", [{label: "小程序", value: 8}, {label: "App", value: 6}, {label: "Web", value: 3}], 3, 16), KeyValue([{label: "统计周期", value: "第 38 周"}, {label: "数据来源", value: "订单与支付明细"}], 1)], "column", 10)
tl = Timeline([{title: "周一", description: "确认本周增长目标与资源", variant: "brand"}, {title: "周三", description: "检查渠道投放效果，调整预算", variant: "info"}, {title: "周五", description: "输出周报并复盘", variant: "success"}])
note = Callout("结论", "小程序渠道持续领跑；Web 环比转负，需要确认是流量下降还是转化问题。", "warning")
