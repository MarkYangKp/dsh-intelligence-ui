root = Stack([h, kpis, funnel, chart, tbl, note], "column", 12)
h = Heading("销售漏斗：从曝光到成单的整体转化率 2.8%", 2)
kpis = Grid([k1, k2, k3], 3, 12, 150)
k1 = StatCard(label: "漏斗整体转化率", value: "2.8%", delta: "+0.3pp", trend: "up", icon: "🫧", note: "曝光到成单", accent: "brand")
k2 = StatCard(label: "最大流失环节", value: "详情页 → 加购", delta: "-18.6%", trend: "down", icon: null, note: "流失 62 万次", accent: "warning")
k3 = StatCard("成单量", "8,420", "同比 +12%", "up", null, null, "success")
funnel = ComparisonBar("各环节人数（万人）", [{label: "曝光", value: 300, variant: "info"}, {label: "详情页浏览", value: 168, variant: "brand"}, {label: "加购", value: 72, variant: "warning"}, {label: "提交订单", value: 18, variant: "success"}, {label: "支付成单", value: 8.4, variant: "success"}], true, " 万人")
chart = Chart("近 6 周成单量", "area", [{name: "成单量", values: [1180, 1260, 1320, 1290, 1410, 1460]}], ["W1", "W2", "W3", "W4", "W5", "W6"], 200, "compact")
tbl = Table("分渠道漏斗转化率", ["渠道", "曝光到加购", "加购到成单", "整体转化"], [{"渠道": "小程序", "曝光到加购": "24.1%", "加购到成单": "12.8%", "整体转化": "3.1%"}, {"渠道": "App", "曝光到加购": "21.6%", "加购到成单": "11.4%", "整体转化": "2.5%"}, {"渠道": "Web", "曝光到加购": "16.2%", "加购到成单": "9.8%", "整体转化": "1.6%"}])
note = Callout("建议", "优先优化详情页到加购的转化，移动端可先做「规格与库存」的清晰化改造。", "info")
