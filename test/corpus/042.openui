root = Stack([h, card, sec, quotes, badges, note], "column", 12)
h = Heading("容器组件：划分信息层级", 2)
card = Card([CardHeader("季度目标", "卡片头提供标题与副标题"), TextContent("卡片用于承载独立的语义块，不要把所有内容都塞进卡片。", "sm")], 16, "brand")
sec = Section("分组内容", "Section 适合同一主题的多段内容", [BulletList(["用发丝线分隔分组", "组内保持一致的间距"])])
quotes = Stack([q1, q2], "column", 8)
q1 = Quote("好的界面让读者感觉不到界面。", "设计评审")
q2 = Quote("结构来自内容，而不是模板。", "内部设计规范")
badges = BadgeGroup(["已上线", "灰度中", "规划中"], "brand")
note = Callout("使用建议", "一屏最多 1–2 处强调色，其余交给字号、留白与发丝线。", "info")
