root = Stack([h, kpis, cmp, chart, tbl, note], "column", 12)
h = Heading("结算页改版 A/B 实验：实验组转化率提升 0.44pp", 2)
kpis = Grid([k1, k2, k3], 3, 12, 150)
k1 = StatCard(label: "实验组转化率", value: "3.86%", delta: "+0.44pp", trend: "up", icon: "🧪", note: "相对提升 12.9%", accent: "success")
k2 = StatCard(label: "对照组转化率", value: "3.42%", delta: null, trend: "flat", icon: null, note: "稳定 14 天", accent: "neutral")
k3 = StatCard("样本量", "42.6 万", "两组各 21.3 万", "flat", null, "随机分流", "brand")
cmp = ComparisonBar("两组核心指标对比", [{label: "实验组转化率", value: 3.86, variant: "success"}, {label: "对照组转化率", value: 3.42, variant: "info"}], true, "%")
chart = Chart("实验期间每日转化率", "line", [{name: "实验组", values: [3.72, 3.80, 3.85, 3.88, 3.91, 3.86]}, {name: "对照组", values: [3.41, 3.43, 3.40, 3.44, 3.42, 3.41]}], ["第 1 天", "第 2 天", "第 3 天", "第 4 天", "第 5 天", "第 6 天"], 220, "number", true)
tbl = Table("分端表现", ["端", "实验组", "对照组", "差异"], [{"端": "iOS", "实验组": "4.12%", "对照组": "3.60%", "差异": "+0.52pp"}, {"端": "Android", "实验组": "3.78%", "对照组": "3.41%", "差异": "+0.37pp"}, {"端": "Web", "实验组": "3.31%", "对照组": "3.08%", "差异": "+0.23pp"}])
note = Callout("结论", "三端方向一致、无负向指标，建议全量；同时继续观察客服咨询量是否因新流程上升。", "success")
