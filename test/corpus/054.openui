root = Stack([h, kpi, content, note], "column", 12)
h = Heading("深嵌套布局：八层容器仍保持结构清晰", 2)
kpi = Grid([k1, k2, k3], 3, 12, 140)
k1 = StatCard("嵌套层级", "8 层", "Card → Section → Grid → Card → Row → Col → Box → Text", "flat", "🧱", null, "brand")
k2 = StatCard("可读性", "正常", "行高与间距未压缩", "flat", null, null, "success")
k3 = StatCard("结论", "不推荐", "超过五层应简化结构", "down", null, null, "warning")
content = Card([Section("分组一", "嵌套层级：Card → Section → Grid → Card → Row → Col → Box → Text", [Grid([deep1, deep2], 2, 12, 200)])])
deep1 = Card([CardHeader("左列", "含 8 层容器"), Row([Col([Box([Row([Icon("🧱", 14, "brand"), Text("第 8 层文本", "sm")], 8, "center")], display="block", padding="8px")], 10)])])
deep2 = Card([CardHeader("右列", "含图表与表格"), Stack([ProgressBar("完成度", 72, 100, "brand"), Table(null, ["项", "值"], [{"项": "A", "值": 1}])], "column", 8)])
note = Callout("约束", "深度不是目标；当嵌套超过五层时，应回头检查信息结构是否可以简化。", "info")
