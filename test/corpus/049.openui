root = Stack([h, t1, t2, stat, note], "column", 12)
h = Heading("数值格式：同一份数据的不同展示", 2)
t1 = Table("指标表现", ["指标", "数值", "环比"], [{"指标": "转化率", "数值": 3.86, "环比": 0.12}, {"指标": "客单价", "数值": 152.7, "环比": -0.02}, {"指标": "复购率", "数值": 0.384, "环比": 0.018}], false, true, true, [{key: "数值", align: "right", format: "number"}, {key: "环比", align: "right", format: "percent"}])
t2 = Table("金额与紧凑格式", ["科目", "金额", "订单量"], [{"科目": "本季收入", "金额": 28400000, "订单量": 186000}, {"科目": "退款金额", "金额": 340800, "订单量": 1240}], false, false, false, [{key: "金额", align: "right", format: "currency"}, {key: "订单量", align: "right", format: "compact"}])
stat = Stack([s1, s2, s3], "row", 12)
s1 = StatCard("百分比", "3.86%", "+0.12pp", "up", null, null, "success")
s2 = StatCard("货币", "¥2,840 万", "+12.6%", "up", null, "含税", "brand")
s3 = StatCard("紧凑数", "18.6 万", null, "flat", null, null, "neutral")
note = Callout("格式化原则", "原始值保留完整精度，仅展示层做格式化；百分比与百分点不要混用。", "info")
