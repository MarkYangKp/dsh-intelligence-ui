root = Stack([h, kpis, chart, heat, tbl, note], "column", 12)
h = Heading("客服工单分析：平均处理时长降至 6.4 小时", 2)
kpis = Grid([k1, k2, k3], 3, 12, 150)
k1 = StatCard("工单总量", "8,240", "较上月 -6.1%", "down", "🎫", null, "brand")
k2 = StatCard("平均处理时长", "6.4 小时", "-1.8 小时", "down", "⏱️", "首次响应 18 分钟", "success")
k3 = StatCard("一次解决率", "82.6%", "+3.4pp", "up", "✅", null, "success")
chart = Chart("各类问题工单量（过去 30 天）", "bar", [{name: "工单量", values: [2480, 1860, 1420, 980, 760, 420, 320]}], [], ["登录与账号", "订单与物流", "支付与退款", "商品咨询", "优惠券使用", "发票问题", "其它"], 240)
heat = Heatmap("每日工单量分布（按周）", [{label: "周一", value: 8}, {label: "周二", value: 6}, {label: "周三", value: 5}, {label: "周四", value: 4}, {label: "周五", value: 3}, {label: "周六", value: 2}, {label: "周日", value: 2}], 4, 18)
tbl = SearchTable("高频问题摘要", ["问题摘要", "出现次数", "处理状态"], [{"问题摘要": "用户反馈登录时提示验证码错误但无法刷新", "出现次数": 320, "处理状态": "已解决"}, {"问题摘要": "订单显示已发货但物流信息长时间没有更新", "出现次数": 268, "处理状态": "处理中"}, {"问题摘要": "退款申请提交后超过三个工作日仍未到账", "出现次数": 196, "处理状态": "已解决"}, {"问题摘要": "优惠券在结算页无法选择且没有错误提示", "出现次数": 154, "处理状态": "排查中"}], "搜索问题摘要…", "没有匹配的问题")
note = Callout("改进方向", "「登录验证码」与「优惠券不可选」两类问题合计占比 24%，建议优先排查前端交互缺陷，而不是增加客服人力。", "warning")
