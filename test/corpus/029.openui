root = Stack([h, c1, c2, note], "column", 12)
h = Heading("今日发布检查单", 2)
c1 = Card(ch, ck)
ch = CardHeader("发布前置检查", "共 8 项，已完成 6 项")
ck = Checklist(null, [{text: "单元测试与集成测试通过", status: "done"}, {text: "变更说明与回滚预案归档", status: "done"}, {text: "灰度指标基线已确认", status: "done"}, {text: "依赖服务版本兼容性已验证", status: "doing"}, {text: "业务方确认发布窗口", status: "todo"}])
c2 = Card(pb1, pb2)
pb1 = ProgressBar("检查项完成度", 60, 100, "success")
pb2 = ProgressBar("回滚演练通过率", 100, 100, "brand")
note = Callout("提醒", "剩余两项需在发布窗口开启前完成，否则顺延到下一窗口，不要在灰度中途补检查项。", "warning")
