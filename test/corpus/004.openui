root = Stack([h, lead, cmp, rows, kv, list, q, note], "column", 12)
h = Heading("HTTP 方法幂等性速查", 2)
lead = TextContent("判断标准只有一条：同一个请求重复发送，服务端资源最终状态是否一致。一致即幂等。", "md")
cmp = Table("常见方法的幂等性", ["方法", "语义", "幂等", "重复执行结果"], rows)
rows = [{"方法": "GET", "语义": "读取资源", "幂等": "是", "重复执行结果": "只读，无副作用"}, {"方法": "PUT", "语义": "整体替换指定资源", "幂等": "是", "重复执行结果": "重复覆盖，结果仍是同一份表示"}, {"方法": "DELETE", "语义": "删除指定资源", "幂等": "是", "重复执行结果": "首次删除后资源已不存在"}, {"方法": "POST", "语义": "提交数据交由服务端处理", "幂等": "否", "重复执行结果": "可能生成多条记录或重复扣款"}]
kv = KeyValue([{label: "约束对象", value: "服务端最终状态，而非响应体"}, {label: "副作用", value: "允许存在，幂等不等于只读"}, {label: "为什么重要", value: "超时后可安全重试"}], 2)
list = BulletList(["GET 与 PUT 的超时重试通常无需额外去重", "POST 建议配合幂等键防止重复提交", "DELETE 重复请求返回 404 或 204 都算幂等"], true)
q = Quote("幂等描述的是最终状态，不是请求次数。", "接口设计评审记录")
note = Callout("实践建议", "支付、下单等写接口即使语义上不是天然幂等，也应通过幂等键补齐。", "info")
