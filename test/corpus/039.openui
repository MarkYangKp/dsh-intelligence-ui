root = Stack([h, meta, q, t, rows, note], "column", 12)
h = Heading("论文速读：小样本场景下的对比学习", 2)
meta = KeyValue([{label: "领域", value: "自监督学习"}, {label: "方法", value: "对比学习 + 数据增强"}, {label: "结论", value: "小样本分类平均提升 4.2pp"}], 3)
q = Quote("在没有大量标注的领域，好的数据增强比更复杂的模型更有效。", "论文结论")
t = Table("主要结果", ["数据集", "基线", "本文方法", "提升"], rows)
rows = [{"数据集": "数据集 A", "基线": "68.4%", "本文方法": "72.8%", "提升": "+4.4pp"}, {"数据集": "数据集 B", "基线": "71.2%", "本文方法": "75.1%", "提升": "+3.9pp"}, {"数据集": "数据集 C", "基线": "64.8%", "本文方法": "69.4%", "提升": "+4.6pp"}]
note = Callout("阅读建议", "先看结果表与消融实验，再回头看方法细节，能更快判断是否值得复现。", "info")
