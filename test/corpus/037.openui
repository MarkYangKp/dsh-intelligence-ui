root = Stack([h, intro, t, rows, code, note], "column", 12)
h = Heading("核心告警规则清单", 2)
intro = TextContent("告警要少而准：每条规则都必须对应一个明确的处置动作。", "md")
t = Table("核心告警规则", ["规则", "阈值", "级别", "处置"], rows)
rows = [{"规则": "订单超时率", "阈值": "5 分钟窗口 > 1%", "级别": "严重", "处置": "先看连接池与下游依赖"}, {"规则": "支付成功率", "阈值": "10 分钟窗口 < 97%", "级别": "严重", "处置": "检查支付通道与回调积压"}, {"规则": "消息积压", "阈值": "队列长度 > 10 万", "级别": "警告", "处置": "扩容消费者并评估限流"}, {"规则": "磁盘使用率", "阈值": "> 85%", "级别": "警告", "处置": "清理日志或扩容"}]
code = CodeBlock("alert: order_timeout_rate\ncondition: rate(5m) > 0.01\nfor: 5m\nseverity: critical\nrunbook: order-timeout", "yaml", "规则示例")
note = Callout("治理建议", "每季度回看告警的误报率与漏报率，把连续三个月未触发的规则降级或删除。", "info")
