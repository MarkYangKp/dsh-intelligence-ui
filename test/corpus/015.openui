root = Stack([h, kpis, pb, ck, added, note], "column", 12)
h = Heading("团队季度 OKR 进度：完成度 68%", 2)
kpis = Grid([k1, k2, k3], 3, 12, 150)
k1 = StatCard("目标完成度", "68%", "+14pp 环比", "up", "🎯", null, "brand")
k2 = StatCard("关键结果", "3 / 5", "两项进行中", "flat", null, null, "success")
k3 = StatCard("风险项", "1", "依赖外部团队", "down", "⚠️", null, "warning")
pb = ProgressBar("季度目标完成度", 68, 100, "brand")
ck = Checklist("关键结果状态", [{text: "核心接口 P99 延迟降至 200ms 以内", status: "done"}, {text: "灰度发布覆盖率提升至 80%", status: "doing"}, {text: "完成两个降本专项的验收", status: "todo"}, {text: "线上事故数较上季度下降 50%", status: "done"}])
added = Table("本周新增事项", ["事项", "负责人"], [])
note = Callout("说明", "本周暂无新增事项；剩余风险集中在降本专项的验收排期，需要在周会上对齐。", "info")
