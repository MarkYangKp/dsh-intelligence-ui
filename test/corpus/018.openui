root = Stack([h, kpis, chart, bars, note], "column", 12)
h = Heading("容量规划：大促前需要预留 2.4 倍峰值余量", 2)
kpis = Grid([k1, k2, k3], 3, 12, 150)
k1 = StatCard("当前峰值 QPS", "1,200", "日常基线 420", "up", "📈", null, "brand")
k2 = StatCard("大促预计峰值", "2,880", "按去年增长 2.4 倍估算", "up", "🚀", null, "warning")
k3 = StatCard("当前集群承载上限", "3,400", "含 20% 安全余量", "flat", null, null, "success")
chart = Chart("各业务线过去三十天的峰值请求量对比（单位：次/秒）", "bar", [{name: "峰值 QPS", values: [1200, 980, 860, 640, 420]}], [], ["商品详情页", "购物车与结算", "订单查询服务", "优惠券领取接口", "个性化推荐流"], 240)
bars = ComparisonBar("大促前各组件的容量水位", [{label: "网关集群", value: 62, variant: "success"}, {label: "订单服务", value: 74, variant: "brand"}, {label: "库存服务", value: 81, variant: "warning"}, {label: "支付回调", value: 88, variant: "error"}, {label: "短信通道", value: 94, variant: "danger"}], true, "%")
note = Callout("扩容优先级", "短信通道与支付回调已接近水位上限，应在大促前两周完成扩缩容演练；其余组件按计划扩容即可。", "warning")
