root = Stack([h, kpis, row1, div, grid2, note], "column", 12)
h = Heading("经营分析仪表盘：收入与活跃度", 2)
kpis = Grid([k1, k2, k3, k4], 4, 12, 130)
k1 = StatCard("本周收入", "84.3 万元", "+12.6%", "up", "💰", null, "brand")
k2 = StatCard("活跃用户", "12.4 万", "+3.1%", "up", "👥", null, "success")
k3 = StatCard("转化率", "3.8%", "+0.2pp", "up", "🎯", null, "success")
k4 = StatCard("退款率", "1.2%", "-0.3pp", "down", "↩️", null, "warning")
row1 = Row([trendCard, heatCard], 12)
trendCard = Card([CardHeader("收入趋势", "近 8 周"), Chart("周收入（万元）", "line", [{name: "收入", values: [62, 66, 64, 71, 69, 75, 78, 84]}], [], ["W1", "W2", "W3", "W4", "W5", "W6", "W7", "W8"], 180)])
heatCard = Card([CardHeader("活跃度热力", "按周与渠道"), Heatmap("渠道活跃度", [{label: "小程序", value: 8}, {label: "App", value: 6}, {label: "Web", value: 3}, {label: "其它", value: 1}], 4, 16)])
div = Divider("明细")
grid2 = Grid([t1, stack2], 2, 12, 200)
t1 = Table("渠道明细", ["渠道", "收入（万元）", "占比"], [{"渠道": "小程序", "收入（万元）": 37.2, "占比": "44.1%"}, {"渠道": "App", "收入（万元）": 29.5, "占比": "35.0%"}, {"渠道": "Web", "收入（万元）": 12.6, "占比": "14.9%"}])
stack2 = Stack([ProgressBar("季度目标完成度", 68, 100, "brand"), Spacer(8), ComparisonBar("各渠道收入", [{label: "小程序", value: 37.2, variant: "brand"}, {label: "App", value: 29.5, variant: "info"}, {label: "Web", value: 12.6}], true, " 万元")], "column", 8)
note = Callout("关注点", "小程序渠道占比继续提升，需要确认其增长来自新客还是存量迁移。", "info")
