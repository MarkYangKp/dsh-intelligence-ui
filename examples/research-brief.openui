root = Stack([hd, meta, tbl, ok], "column", 12)
hd = Heading("论文速读：ExtractBench 提出覆盖率感知的长文档抽取评测", 2)
meta = KeyValue([{label: "任务", value: "长文档结构化抽取"}, {label: "数据集", value: "3 个领域 / 1.2 万篇"}, {label: "模型", value: "3 个基线 + 2 个提出方法"}], 3)
tbl = Table("主结果（F1）", ["方法", "财务", "法务", "医疗", "平均"], [{"方法": "基线 A", "财务": "0.61", "法务": "0.58", "医疗": "0.55", "平均": "0.58"}, {"方法": "基线 B", "财务": "0.66", "法务": "0.62", "医疗": "0.60", "平均": "0.63"}, {"方法": "本文方法", "财务": "0.71", "法务": "0.69", "医疗": "0.64", "平均": "0.68"}])
ok = Callout("结论", "提升主要来自覆盖率感知的重提取策略（+4.1），但长文档尾部召回仍是瓶颈。", "success")
