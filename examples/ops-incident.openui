root = Stack([hd, kpis, tl, tbl, fix], "column", 12)
hd = Heading("P1 故障复盘：网关证书过期导致 23 分钟不可用", 2)
kpis = Grid([k1, k2, k3], 3, 12, 150)
k1 = StatCard("影响时长", "23 分钟", "14:02–14:25", "down", "⏱", null, "warning")
k2 = StatCard("受影响请求", "18.4 万", "错误率峰值 61%", "down", "📉", null, "warning")
k3 = StatCard("恢复方式", "热更新证书", "未回滚版本", "flat", "🔧", null, "success")
tl = Timeline([{"title": "告警触发", "time": "14:02", "description": "网关 5xx 比例 3 分钟内升至 61%", "variant": "error"}, {"title": "定位根因", "time": "14:09", "description": "证书链校验失败，确认上游证书已过期", "variant": "warning"}, {"title": "热更新证书", "time": "14:21", "description": "灰度节点验证通过后全量下发", "variant": "success"}, {"title": "恢复确认", "time": "14:25", "description": "错误率回落至 0.1% 以下，告警关闭", "variant": "success"}])
tbl = Table("根因与改进项", ["项", "结论", "负责人"], [{"项": "直接原因", "结论": "入口证书 90 天有效期到期，未进入续期流程", "负责人": "平台组"}, {"项": "放大因素", "结论": "证书校验失败未降级，直接返回 5xx", "负责人": "网关组"}, {"项": "改进项", "结论": "证书到期 30 天前自动告警 + 到期前 7 天自动续签", "负责人": "平台组"}])
fix = Callout("经验", "证书类故障的检测必须独立于证书本身；监控探针不要复用同一份信任链。", "info")
