root = Stack([hd, kpis, trend, tbl, note], "column", 16)
hd = Heading("Weekly business review", 2)
kpis = Grid([k1, k2, k3, k4], 4, 12, 150)
k1 = StatCard("Revenue", "¥84,300", "+12.6%", "up", null, "gross, tax included", "brand")
k2 = StatCard("New users", "1,204", "+3.1%", "up", null, "vs. last week", "success")
k3 = StatCard("Refund rate", "1.2%", "-0.3%", "down", null, "below the 2% guardrail", "warning")
k4 = StatCard("Repeat rate", "41.2%", "+0.8%", "up", null, "90-day window")
trend = Chart("Daily revenue", "area", [{name: "Revenue", values: [1120, 1310, 980, 1420, 1290, 1680, 1750]}], [], ["Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun"], 220)
tbl = Table("Channel mix", [{"key": "channel", "label": "Channel"}, {"key": "orders", "label": "Orders", "align": "right", "format": "number"}, {"key": "share", "label": "Share", "align": "right", "format": "percent"}], [{"channel": "Mini app", "orders": 5320, "share": 0.442}, {"channel": "App", "orders": 4210, "share": 0.35}, {"channel": "Web", "orders": 1804, "share": 0.15}])
note = Callout("Takeaway", "Revenue grew for three weeks in a row; shift budget toward the App channel.", "success")
